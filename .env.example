# Same Supabase project as the JRI user app — consultants are the same auth system,
# a different application. Both values are public by design: the anon key ships inside
# every browser bundle already deployed, and RLS is what protects the data, not this key.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY here. Anything prefixed VITE_ is compiled into
# JavaScript any visitor can read, and the service-role key bypasses RLS entirely.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where to send someone who turns out to be a business owner, not a consultant.
# This said app.jri.ai, which does not resolve — the user app is at user.jri.ai.
VITE_USER_APP_URL=https://user.jri.ai
